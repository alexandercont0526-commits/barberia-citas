# Copia este archivo como ".env" y ajusta los valores.
# El servidor lo carga automáticamente al iniciar (Node >= 20.12).

# Contraseña del panel del barbero. ¡CÁMBIALA!
ADMIN_PASSWORD=barbero123

# Nombre de tu barbería (aparece en la app y los mensajes)
SHOP_NAME=Mi Barbería

# Tu WhatsApp con código de país, solo dígitos (ej. Venezuela: 584121234567)
# Déjalo vacío para ocultar el botón de WhatsApp a los clientes.
SHOP_WHATSAPP=

# Horario de atención (formato 24h, ej. 09:00 a 19:00)
HORA_INICIO=09:00
HORA_FIN=19:00

# Duración de cada cita en minutos (mínimo 10)
INTERVALO=30

# Días abiertos: 0=domingo, 1=lunes, ... 6=sábado
DIAS_ABIERTOS=1,2,3,4,5,6

# Minutos mínimos de anticipación para reservar el mismo día
MIN_ANTICIPACION=30

# Máximo de citas activas por teléfono y día (0 = sin límite)
MAX_CITAS_POR_DIA=3

# Puerto del servidor
PORT=3000

# ============================================================
# Avisos por email (OPCIONAL). Si estos campos están vacíos,
# los avisos se desactivan y la app funciona igual.
# ============================================================

# Correo donde quieres recibir el aviso de cada nueva cita
SHOP_EMAIL=

# Servidor SMTP de tu correo (ej. smtp.gmail.com con una "app password")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Solo déjalo en false si tu SMTP usa STARTTLS en el 587
SMTP_SECURE=true
# Remitente (opcional; por defecto usa SHOP_EMAIL)
SMTP_FROM=
